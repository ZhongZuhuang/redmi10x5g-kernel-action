diff --git a/fs/exec.c b/fs/exec.c
--- a/fs/exec.c
+++ b/fs/exec.c
@@
 static const char __user *get_user_arg_ptr(struct user_arg_ptr argv, int nr)
 {
 	const char __user *native;
@@
 
 	return native;
 }
+
+static bool is_zero_width_utf8(const unsigned char *s, int left, int *skip)
+{
+	if (left >= 3 && s[0] == 0xe2 && s[1] == 0x80 &&
+	    (s[2] == 0x8b || s[2] == 0x8c || s[2] == 0x8d ||
+	     s[2] == 0x8e || s[2] == 0x8f)) {
+		*skip = 3;
+		return true;
+	}
+
+	if (left >= 3 && s[0] == 0xef && s[1] == 0xbb && s[2] == 0xbf) {
+		*skip = 3;
+		return true;
+	}
+
+	if (left >= 4 && s[0] == 0xf3 && s[1] == 0xa0 &&
+	    s[2] == 0x80 && s[3] == 0x80) {
+		*skip = 4;
+		return true;
+	}
+
+	return false;
+}
+
+static int sanitized_user_arg_len(const char __user *str, int *out_len)
+{
+	char *buf;
+	long len;
+	int i, skip;
+
+	len = strnlen_user(str, MAX_ARG_STRLEN);
+	if (!len)
+		return -EFAULT;
+	if (len > MAX_ARG_STRLEN)
+		return -E2BIG;
+
+	buf = memdup_user(str, len);
+	if (IS_ERR(buf))
+		return PTR_ERR(buf);
+
+	for (i = 0; i < len - 1; i += skip) {
+		skip = 1;
+		if (is_zero_width_utf8(buf + i, len - 1 - i, &skip)) {
+			kfree(buf);
+			return -EACCES;
+		}
+	}
+
+	kfree(buf);
+	*out_len = len;
+	return 0;
+}
 
 /*
  * count() counts the number of strings in array ARGV.
@@
-		len = strnlen_user(str, MAX_ARG_STRLEN);
-		if (!len)
+		ret = sanitized_user_arg_len(str, &len);
+		if (ret)
 			goto out;
 
 		ret = -E2BIG;
