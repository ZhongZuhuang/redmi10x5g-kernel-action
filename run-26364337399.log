2026-05-24T14:47:57.6933594Z [36;1m# we want to reuse the temp disk, so first unmount swap and clean the temp disk[0m
2026-05-24T14:47:57.6934203Z [36;1mecho "Unmounting and removing swap file."[0m
2026-05-24T14:47:57.6934591Z [36;1msudo swapoff -a[0m
2026-05-24T14:47:57.6935055Z [36;1msudo rm -f /mnt/swapfile[0m
2026-05-24T14:47:57.6935389Z [36;1m[0m
2026-05-24T14:47:57.6935690Z [36;1mecho "Creating LVM Volume."[0m
2026-05-24T14:47:57.6936060Z [36;1mecho "  Creating LVM PV on root fs."[0m
2026-05-24T14:47:57.6936451Z [36;1m# create loop pv image on root fs[0m
2026-05-24T14:47:57.6936842Z [36;1mROOT_RESERVE_KB=$(expr 8192 \* 1024)[0m
2026-05-24T14:47:57.6937300Z [36;1mROOT_FREE_KB=$(df --block-size=1024 --output=avail / | tail -1)[0m
2026-05-24T14:47:57.6937823Z [36;1mROOT_LVM_SIZE_KB=$(expr $ROOT_FREE_KB - $ROOT_RESERVE_KB)[0m
2026-05-24T14:47:57.6938308Z [36;1mROOT_LVM_SIZE_BYTES=$(expr $ROOT_LVM_SIZE_KB \* 1024)[0m
2026-05-24T14:47:57.6938857Z [36;1msudo touch "/pv.img" && sudo fallocate -z -l "${ROOT_LVM_SIZE_BYTES}" "/pv.img"[0m
2026-05-24T14:47:57.6939435Z [36;1mexport ROOT_LOOP_DEV=$(sudo losetup --find --show "/pv.img")[0m
2026-05-24T14:47:57.6939909Z [36;1msudo pvcreate -f "${ROOT_LOOP_DEV}"[0m
2026-05-24T14:47:57.6940265Z [36;1m[0m
2026-05-24T14:47:57.6940556Z [36;1m# create pv on temp disk[0m
2026-05-24T14:47:57.6940937Z [36;1mecho "  Creating LVM PV on temp fs."[0m
2026-05-24T14:47:57.6941319Z [36;1mTMP_RESERVE_KB=$(expr 2048 \* 1024)[0m
2026-05-24T14:47:57.6941771Z [36;1mTMP_FREE_KB=$(df --block-size=1024 --output=avail /mnt | tail -1)[0m
2026-05-24T14:47:57.6942283Z [36;1mTMP_LVM_SIZE_KB=$(expr $TMP_FREE_KB - $TMP_RESERVE_KB)[0m
2026-05-24T14:47:57.6942768Z [36;1mTMP_LVM_SIZE_BYTES=$(expr $TMP_LVM_SIZE_KB \* 1024)[0m
2026-05-24T14:47:57.6943359Z [36;1msudo touch "/mnt/tmp-pv.img" && sudo fallocate -z -l "${TMP_LVM_SIZE_BYTES}" "/mnt/tmp-pv.img"[0m
2026-05-24T14:47:57.6944275Z [36;1mexport TMP_LOOP_DEV=$(sudo losetup --find --show "/mnt/tmp-pv.img")[0m
2026-05-24T14:47:57.6944790Z [36;1msudo pvcreate -f "${TMP_LOOP_DEV}"[0m
